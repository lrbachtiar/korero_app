<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for reading/writing files outside the sandbox -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    <!-- Required for spawning the sidecar process -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- Required for PyInstaller bundled Python -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- Required for Metal (PyTorch MPS) -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- Network (for model download on first run only) -->
    <key>com.apple.security.network.client</key>
    <true/>
</dict>
</plist>
